{
  "name": "ulising-launcher",
  "productName": "Ulising Launcher",
  "version": "1.0.0",
  "description": "Launcher de desktop gamer que troca papel de parede, cores do Windows e a barra de tarefas com estilos Gamer, Tecnológico, Minimalista, Anime e mais.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.ulising.launcher",
    "productName": "Ulising Launcher",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "scripts/windows",
        "to": "scripts"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
